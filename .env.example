# ═══════════════════════════════════════════════════════════════
# NebulaGrid — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# How each component reads these:
#   Gateway   → dotenvy auto-loads .env from control-plane/
#               + CLI args (--http-port, --jwt-secret, etc.)
#   Agent     → CLI args only (--server, --token, etc.)
#               env vars also work (AGENT_SERVER_URL, etc.)
#   Dashboard → Vite dev server proxies /api and /ws to gateway
#               configured in vite.config.ts (port 3000)
# ═══════════════════════════════════════════════════════════════

# ─── Gateway ───────────────────────────────────────────────────
# Controls the Rust API Gateway (Axum) on port 8080.
# Loaded by: dotenvy + clap in gateway/src/config.rs

HTTP_PORT=8080
  # TCP port for the REST + WebSocket API server
  # Default: 8080

GRPC_PORT=9000
  # TCP port for the Agent gRPC server (tonic)
  # Default: 9000
  # Note: gRPC server is scaffolded but runs in background

DATABASE_URL=postgres://nebula:nebula_dev@localhost:5432/nebula
  # PostgreSQL connection string (SQLx)
  # !!! REQUIRED — no default !!!
  # Gateway still works without Postgres (uses in-memory store)
  # Set to: postgres://user:password@host:port/database

REDIS_URL=redis://localhost:6379
  # Redis connection for caching + sessions
  # Default: redis://localhost:6379
  # Optional — currently unused in code

NATS_URL=nats://localhost:4222
  # NATS message broker URL for microservice communication
  # Default: nats://localhost:4222
  # Optional — services use in-memory until NATS is connected

JWT_SECRET=change-this-to-a-secure-random-string
  # !!! REQUIRED — no default !!!
  # HMAC-SHA256 secret key for signing JWT tokens
  # Generate with: openssl rand -base64 64
  # In dev: any string works

JWT_EXPIRY_HOURS=24
  # JWT access token lifetime in hours
  # Default: 24

AGENT_TOKEN=change-this-to-a-secure-agent-token
  # !!! REQUIRED — no default !!!
  # Pre-shared token that agents use to authenticate
  # with the gateway. Must match agent's --token flag.
  # In dev: set to 'dev-token'

RUST_LOG=info
  # Rust tracing/logging level
  # Values: error, warn, info, debug, trace
  # Default: info

# ─── Agent ─────────────────────────────────────────────────────
# Controls the Rust Agent (sysinfo collector) on each server.
# Loaded by: clap in agent/src/config.rs
# Can use env vars OR CLI flags (--server, --token, --name, etc.)

AGENT_SERVER_URL=http://localhost:8080
  # Gateway URL that the agent reports metrics to
  # Maps to CLI: --server
  # Example: http://gateway.example.com:8080

AGENT_TOKEN=change-this-to-a-secure-agent-token
  # Must match AGENT_TOKEN in Gateway config
  # Maps to CLI: --token

AGENT_HOSTNAME=
  # Override the reported hostname (empty = auto-detect)
  # Maps to CLI: --name / -n

METRICS_INTERVAL_SECONDS=10
  # How often the agent collects & sends metrics (seconds)
  # Maps to CLI: --interval / -i
  # Default: 10

# ─── Advanced Agent Flags (CLI only) ──────────────────────────
# These must be passed as CLI args, not env vars:
#   --grpc-port 9000    # Agent gRPC server port (default: 9000)
#   --no-docker         # Skip Docker container collection
#   --verbose           # Enable debug logging

# ─── Dashboard ─────────────────────────────────────────────────
# Settings for the React frontend.
# Configured in: dashboard/vite.config.ts
#
# Dev server:     http://localhost:3000
# API proxy:      /api → http://localhost:8080
# WebSocket proxy: /ws → ws://localhost:8080
#
# No env vars needed — the Vite dev proxy handles routing.
# For production, build with: cd dashboard && npm run build
# Then serve the dist/ folder via any static file server.
